[
  {
    "id": "reader-article-template",
    "name": "Reader article",
    "type": "Template",
    "command": true,
    "onePageInput": "always",
    "templatePath": "Templates/Reader/Article.md",
    "fileNameFormat": {
      "enabled": true,
      "format": "{{DATE:YYMMDD}} Article {{DATE:HH-mm-ss-SSS}}"
    },
    "folder": {
      "enabled": true,
      "folders": [
        "Reading/Inbox"
      ],
      "chooseWhenCreatingNote": false,
      "createInSameFolderAsActiveFile": false,
      "chooseFromSubfolders": false
    },
    "appendLink": false,
    "copyLinkToClipboard": false,
    "openFile": true,
    "fileOpening": {
      "location": "tab",
      "direction": "vertical",
      "mode": "default",
      "focus": true
    },
    "fileExistsBehavior": {
      "kind": "apply",
      "mode": "duplicateSuffix"
    },
    "discoverExistingNotesBeforeCreate": false
  },
