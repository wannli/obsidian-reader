[
  {
    "name": "quoted multiline input remains data",
    "choice": "Reader article",
    "variables": {
      "url": "https://example.com/article?q=100%25&tag=a:b",
      "articleTitle": "../../outside: \"quoted\"\nstatus: archive",
      "comments": "Personal first line\n\n{{DATE}} <% throw new Error('must not run') %>\n## Personal heading\nKeep this text."
    },
    "expected": {
      "inferredStatus": "inbox",
      "statusInFrontmatter": false,
      "folder": "Reading/Inbox/",
      "filenameFormat": "{{DATE:YYMMDD}} Article {{DATE:HH-mm-ss-SSS}}",
      "titleEqualsInput": true,
      "urlEqualsInput": true,
      "commentsContainExactInput": true,
      "quickAddOpeningMode": "default",
      "readerOpensWhenEnabled": true,
      "nativeMarkdownOpensWithoutReader": true,
      "editorCursorPlacementRequested": false
    }
  },
  {
    "name": "blank optional fields are accepted",
    "choice": "Reader article",
    "variables": { "url": "https://example.com/blank", "articleTitle": "", "comments": "" },
    "expected": { "title": "", "filenameFormat": "{{DATE:YYMMDD}} Article {{DATE:HH-mm-ss-SSS}}", "statusInFrontmatter": false, "created": true }
  },
  {
    "name": "cancel missing-field prompt",
    "choice": "Reader article",
    "variables": { "url": "https://example.com/cancel" },
    "action": "Cancel or Escape the title/comments input form",
    "expected": { "created": false }
  },
  {
    "name": "quick capture automatic acquisition",
    "choice": "Reader article quick",
    "variables": { "url": "https://example.com/quick" },
    "expected": {
      "folder": "Reading/Inbox/",
      "inferredStatus": "inbox",
      "statusInFrontmatter": false,
      "titlePrompt": false,
      "commentsPrompt": false,
      "manualOpenReaderViewRequired": false,
      "readerOpensWhenEnabled": true,
      "manualExtractionCommandRequired": false,
      "dummyDefault": true,
      "personalCommentsPreserved": true
    }
  }
]
